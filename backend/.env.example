# ========================================================
# Khamsa CMS API - Environment Configuration Template
# Brand: خمسة برمجة بالبلدي
# ========================================================

# Server Configuration
NODE_ENV=production
PORT=5000

# Client Application URLs (Comma-separated for multiple origins, e.g. production domain + dashboard)
CLIENT_URL=https://khamsa.dev,https://www.khamsa.dev

# MongoDB Atlas Production Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/khamsa_cms?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate using: openssl rand -base64 32)
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_secure_random_string_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2 Media Storage Configuration (S3-Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=khamsa-media
R2_PUBLIC_URL=https://media.khamsa.dev

# Initial Super Admin (Used only by initial seed script)
ADMIN_NAME=ربيع شعبان
ADMIN_EMAIL=admin@khamsa.dev
ADMIN_PASSWORD=SetAStrongPasswordHere123!
